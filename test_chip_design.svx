/*
SpectraVortex Hardware Compilation Test
Simple photonic chip design for testing hardware backend
*/

// ========== VORTEX SOURCES ==========
// Create OAM sources with different charges
vortex source_plus1 = {
    oam_charge: +1,
    wavelength: 1550e-9,
    waist: 2.0,
    profile: "laguerre_gaussian",
    power: 1.0
}

vortex source_minus2 = {
    oam_charge: -2,
    wavelength: 1550e-9,
    waist: 2.0,
    profile: "laguerre_gaussian",
    power: 1.0
}

vortex source_zero = {
    oam_charge: 0,
    wavelength: 1550e-9,
    waist: 2.0,
    profile: "gaussian",
    power: 1.0
}

// ========== VORTEX BEAMS ==========
// Create Laguerre-Gaussian beams
vortex_beam lg_plus1 = laguerre_gaussian(
    oam_charge: +1,
    radial_order: 0,
    waist: 1.5,
    wavelength: 1550e-9
)

vortex_beam lg_minus2 = laguerre_gaussian(
    oam_charge: -2,
    radial_order: 0,
    waist: 1.5,
    wavelength: 1550e-9
)

// ========== INTERFERENCE TESTS ==========
// Test interference between different OAM modes
program test_interference() {
    print("=== Testing OAM Interference ===");
    
    // Same OAM - should work well
    result1 = interfere(lg_plus1, lg_plus1);
    print("1. OAM+1 @ OAM+1:");
    print("   Visibility:", result1.visibility);
    print("   Should be: High (similar OAM)");
    
    // Different OAM - reduced visibility
    result2 = interfere(lg_plus1, lg_minus2);
    print("\n2. OAM+1 @ OAM-2:");
    print("   Visibility:", result2.visibility);
    print("   Should be: Low (different OAM)");
}

// ========== MATRIX OPERATIONS ==========
// Test matrix for optical computation
test_matrix = {
    rows: 2,
    cols: 2,
    value: [
        [0.707, 0.707],  // 45° rotation
        [-0.707, 0.707]
    ]
}

program test_matrix_ops() {
    print("\n=== Testing Matrix Operations ===");
    
    print("Test matrix:", test_matrix);
    
    // Encode for optical processing
    encoded = encode_matrix(test_matrix);
    print("Matrix encoded for optical processing");
    
    // Simple identity test
    identity = {
        rows: 2,
        cols: 2,
        value: [
            [1.0, 0.0],
            [0.0, 1.0]
        ]
    };
    
    print("\nIdentity matrix:", identity);
}

// ========== CHIP DESIGN COMMENTS ==========
/*
What the hardware compiler should create:

1. OAM SOURCES (3x):
   - OAM+1 vortex source
   - OAM-2 vortex source  
   - Gaussian source (OAM=0)

2. INTERFEROMETERS (2x):
   - MZI for OAM+1 self-interference
   - MZI for OAM+1 @ OAM-2 interference

3. MATRIX CORE:
   - 2x2 MZI mesh for unitary operations
   - 2 MZI elements total

4. CONNECTIONS:
   - Waveguides between sources and interferometers
   - Output waveguides to detectors

Expected chip size: ~300x300 μm
*/

// ========== FINAL TEST PROGRAM ==========
program run_all_tests() {
    print("========================================");
    print("SPECTRAVORTEX HARDWARE COMPILATION TEST");
    print("========================================");
    print();
    
    print("1. Creating OAM sources...");
    print("   • OAM+1 source created");
    print("   • OAM-2 source created");
    print("   • Gaussian source created");
    print();
    
    print("2. Creating vortex beams...");
    print("   • LG mode +1 created");
    print("   • LG mode -2 created");
    print();
    
    // Run interference tests
    test_interference();
    
    // Run matrix tests
    test_matrix_ops();
    
    print();
    print("========================================");
    print("TEST COMPLETE - Ready for chip compilation!");
    print("========================================");
    print();
    print("To compile to chip, run:");
    print("  python main.py --compile-chip test_chip_design.svx my_chip.gds");
}

// Entry point
run_all_tests();
