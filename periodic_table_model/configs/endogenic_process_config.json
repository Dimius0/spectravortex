{
  "metadata": {
    "description": "Конфигурация эндогенного процесса для поля H",
    "version": "1.0.0",
    "principle": "Поле H работает только на сквозной"
  },
  "initialization": {
    "grid_size": 512,
    "elements_to_load": "all_103",
    "isotopes_to_load": "all_known",
    "intermetallides_predefined": "all_known",
    "initial_placement": "fractal_spiral",
    "random_seed": 42,
    "_comment_random_seed": "Фиксирован для воспроизводимости. Не влияет на физические предсказания."
  },
  "relaxation_phases": [
    {
      "phase": 1,
      "name": "topological_ordering",
      "iterations": 1000,
      "temperature_K": 1000,
      "pressure_GPa": 0.1,
      "objective": "minimize_vortex_energy",
      "constraints": {
        "min_distance_fm": 2.0,
        "topological_charge_conservation": true
      }
    },
    {
      "phase": 2,
      "name": "bond_formation",
      "iterations": 2000,
      "temperature_K": 800,
      "pressure_GPa": 0.1,
      "objective": "minimize_total_energy",
      "constraints": {
        "min_distance_fm": 1.5,
        "symmetry_compatibility_min": 0.7
      },
      "adaptive_routing": {
        "enabled": true,
        "gradient_threshold": 0.1,
        "max_bonds_per_element": 12
      }
    },
    {
      "phase": 3,
      "name": "isotope_stabilization",
      "iterations": 500,
      "temperature_K": 300,
      "pressure_GPa": 0.1,
      "objective": "minimize_quantum_fluctuations",
      "constraints": {
        "min_distance_fm": 1.0,
        "decay_threshold_MeV": 8.0
      }
    },
    {
      "phase": 4,
      "name": "fractal_growth",
      "iterations": 1500,
      "temperature_K": 500,
      "pressure_GPa": 5.0,
      "objective": "maximize_fractal_dimension",
      "constraints": {
        "min_distance_fm": 0.5,
        "pressure_effect": true
      }
    }
  ],
  "output": {
    "formats": ["json", "hdf5", "vdb"],
    "fields": ["density", "gradient", "phase", "energy_density"],
    "visualization": {
      "isosurfaces": [0.1, 0.3, 0.5, 0.7, 0.9],
      "streamlines": true,
      "nodes": "polyhedra",
      "bonds": "tubes"
    }
  }
}