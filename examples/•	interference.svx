// ============================================
// Пример: ИНТЕРФЕРЕНЦИЯ ДВУХ ПУЧКОВ
// Демонстрация оператора '+' как физической интерференции
// ============================================

// 1. СОЗДАНИЕ БАЗОВОГО ФОТОНА (источник)
photon laser_source = {
    frequency: 193.414e12,  // 1550 нм (телекоммуникационный диапазон)
    amplitude: 1.0,         // полная амплитуда
    phase: 0.0,             // начальная фаза
    oam: 0,                 // нулевой орбитальный угловой момент
    polarization: "linear", // линейная поляризация
    duration: 100e-12,      // длительность импульса 100 пс
    coherence_time: 10e-9   // время когерентности 10 нс
}

// 2. СОЗДАНИЕ ДВУХ ПУЧКОВ С РАЗНЫМИ ПАРАМЕТРАМИ
//    beam1 - основной пучок (амплитуда 0.8, фаза 0)
beam beam1 = beam(laser_source) with {
    amplitude: 0.8,
    phase: 0.0
}

//    beam2 - интерферирующий пучок (амплитуда 0.6, фаза PI/2)
beam beam2 = beam(laser_source) with {
    amplitude: 0.6,
    phase: 3.14159 / 2  // π/2 ≈ 90 градусов
}

// 3. ДЕМОНСТРАЦИЯ ИНТЕРФЕРЕНЦИИ (+ КАК ФИЗИЧЕСКИЙ ОПЕРАТОР)
//    Оператор '+' в SpectraVortex означает КОГЕРЕНТНУЮ ИНТЕРФЕРЕНЦИЮ
program demonstrate_interference() -> Float {
    
    print("=== ДЕМОНСТРАЦИЯ ИНТЕРФЕРЕНЦИИ В SPECTRAVORTEX ===")
    print("Пучок 1: амплитуда = 0.8, фаза = 0°")
    print("Пучок 2: амплитуда = 0.6, фаза = 90°")
    print("")
    
    // 3.1. ПРЯМАЯ ИНТЕРФЕРЕНЦИЯ ОПЕРАТОРОМ '+'
    print("1. Прямая интерференция (beam1 + beam2):")
    beam interfered_beam = beam1 + beam2
    
    // 3.2. ИЗМЕРЕНИЕ РЕЗУЛЬТАТА
    result_intensity = measure(interfered_beam, "intensity")
    print("   Результирующая интенсивность:", result_intensity)
    
    // 3.3. ТЕОРЕТИЧЕСКИЙ РАСЧЕТ ДЛЯ ПРОВЕРКИ
    // Для двух когерентных волн: I = |A1·e^(iφ1) + A2·e^(iφ2)|²
    // A1=0.8, φ1=0; A2=0.6, φ2=π/2
    // I = (0.8)² + (0.6)² + 2·0.8·0.6·cos(π/2) = 0.64 + 0.36 + 0 = 1.0
    print("   Теоретическое значение: 1.0")
    print("")
    
    // 3.4. ДЕМОНСТРАЦИЯ РАЗНЫХ ФАЗОВЫХ СООТНОШЕНИЙ
    print("2. Эксперимент с разными фазами:")
    
    // Создаем пучок с изменяемой фазой
    beam adjustable_beam = beam(laser_source) with {
        amplitude: 0.7,
        phase: 0.0  // начальная фаза
    }
    
    // Массив фаз для эксперимента
    phase_values = [0.0, 1.5708, 3.14159, 4.71239]  // 0°, 90°, 180°, 270°
    phase_names = ["0°", "90°", "180°", "270°"]
    
    for i in range(0, 4) {
        // Меняем фазу второго пучка
        beam2_experiment = beam(laser_source) with {
            amplitude: 0.7,
            phase: phase_values[i]
        }
        
        // Интерференция
        experiment_beam = beam1 + beam2_experiment
        exp_intensity = measure(experiment_beam, "intensity")
        
        print("   Фаза:", phase_names[i], "-> Интенсивность:", exp_intensity)
    }
    
    print("")
    print("=== ОБЪЯСНЕНИЕ ===")
    print("В SpectraVortex оператор '+' реализует ФИЗИЧЕСКУЮ интерференцию.")
    print("Компилятор транслирует это в соответствующую оптическую схему.")
    print("")
    print("Для beam1 (0.8∠0°) и beam2 (0.6∠90°):")
    print("   I = |0.8·e^(i·0) + 0.6·e^(i·π/2)|²")
    print("     = |0.8 + 0.6i|²")
    print("     = 0.8² + 0.6² = 1.0")
    
    return result_intensity
}

// 4. ВСПОМОГАТЕЛЬНАЯ ФУНКЦИЯ: ВИЗУАЛИЗАЦИЯ ИНТЕРФЕРЕНЦИОННОЙ КАРТИНЫ
function visualize_interference(beam_a: Beam, beam_b: Beam) -> Image {
    // Эта функция создает визуализацию интерференционной картины
    // (В реальной реализации будет генерировать изображение)
    print("Визуализация интерференционной картины...")
    
    // Симуляция интерференции в симуляторе
    interference_pattern = simulate_interference(beam_a, beam_b, {
        grid_size: 256,
        wavelength: 1550e-9
    })
    
    return interference_pattern
}

// 5. ГЛАВНАЯ ПРОГРАММА ДЛЯ ЗАПУСКА
program main() {
    print("Запуск демонстрации интерференции...")
    print("")
    
    // Запуск основной демонстрации
    final_result = demonstrate_interference()
    
    // Дополнительная визуализация (если функция реализована)
    // interference_image = visualize_interference(beam1, beam2)
    
    print("")
    print("✅ Демонстрация завершена!")
    print("Итоговая интенсивность:", final_result)
}
